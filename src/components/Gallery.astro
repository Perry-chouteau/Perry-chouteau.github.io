---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { byOrientation, imageFull } from '../lib/media';

type Props = { images: ImageMetadata[]; alt: string };
const { images, alt } = Astro.props;

/* Version haute-resolution servie au lightbox (clic pour agrandir). */
const fullOf = new Map<ImageMetadata, string>();
await Promise.all(images.map(async (img) => void fullOf.set(img, await imageFull(img))));

/*
 * Portrait d'abord, paysage ensuite. Chaque groupe a SON ratio, donc toutes
 * les vignettes d'une grille ont la meme hauteur. On recadre (object-cover)
 * plutot que de laisser des bandes vides : une photo 4/3 dans un cadre 16/10
 * perd quelques pixels sur les bords, ce qui se voit moins qu'un trou.
 */
const { portrait, landscape } = byOrientation(images);

const groups = [
  { images: portrait, ratio: 'aspect-[3/4]', cols: 'sm:grid-cols-3 lg:grid-cols-4' },
  { images: landscape, ratio: 'aspect-[4/3]', cols: 'sm:grid-cols-2 lg:grid-cols-3' },
].filter((g) => g.images.length > 0);
---

<div class="space-y-4">
  {
    groups.map((group) => (
      <div class:list={['grid gap-4', group.cols]}>
        {group.images.map((img, i) => (
          <figure
            data-lightbox
            data-full={fullOf.get(img)}
            data-alt={`${alt} — ${i + 1}`}
            class:list={[
              'cursor-zoom-in overflow-hidden rounded-card border border-line-soft bg-surface',
              group.ratio,
            ]}
          >
            <Image
              src={img}
              alt={`${alt} — ${i + 1}`}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
              format="webp"
              quality={80}
              loading={i < 4 ? 'eager' : 'lazy'}
              class="size-full object-cover"
            />
          </figure>
        ))}
      </div>
    ))
  }
</div>
