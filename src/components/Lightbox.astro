---
/*
 * Lightbox global, rendu UNE fois dans le layout. Il n'a aucune connaissance
 * des images : n'importe quel element portant [data-lightbox] + data-full
 * l'ouvre (delegation d'evenement sur le document). Ajouter une galerie ne
 * demande donc rien ici.
 *
 * Fermeture : un clic n'importe ou (l'overlay couvre l'image comprise) ou Echap.
 */
---

<div
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Aperçu de l'image"
  aria-hidden="true"
  class="fixed inset-0 z-50 hidden cursor-zoom-out flex-col items-center justify-center gap-3 bg-black/75 p-4 backdrop-blur-md sm:p-8"
>
  {/* Bouton fermer explicite — l'affordance principale pour sortir. */}
  <button
    id="lightbox-close"
    type="button"
    aria-label="Fermer l'aperçu"
    class="absolute right-4 top-4 inline-flex size-10 items-center justify-center rounded-full border border-white/20 bg-black/40 text-white/90 transition-colors hover:bg-black/70 hover:text-white"
  >
    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  {/* Image contenue (pas plein cadre) : elle se lit comme un aperçu, pas comme un nouvel écran. */}
  <img
    id="lightbox-img"
    src=""
    alt=""
    class="max-h-[82vh] max-w-[92vw] rounded-lg border border-white/10 object-contain shadow-2xl"
  />

  {/* Indice de sortie. */}
  <p class="pointer-events-none flex select-none items-center gap-1.5 text-xs text-white/55">
    Cliquer n'importe où ou
    <kbd class="rounded border border-white/25 px-1.5 py-0.5 font-mono text-[0.65rem] text-white/75">Échap</kbd>
    pour fermer
  </p>
</div>

<script>
  const box = document.getElementById('lightbox') as HTMLDivElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;

  const open = (src: string, alt: string) => {
    img.src = src;
    img.alt = alt;
    box.classList.replace('hidden', 'flex');
    box.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    box.classList.replace('flex', 'hidden');
    box.setAttribute('aria-hidden', 'true');
    img.removeAttribute('src');
    document.body.style.overflow = '';
  };

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
    if (trigger?.dataset.full) {
      open(trigger.dataset.full, trigger.dataset.alt ?? '');
      return;
    }
    /* Overlay ouvert : tout clic dedans (image incluse) ferme. */
    if (box.classList.contains('flex') && box.contains(e.target as Node)) close();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && box.classList.contains('flex')) close();
  });
</script>
