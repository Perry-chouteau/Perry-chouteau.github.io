---
import { Image } from 'astro:assets';
import type { Media, MediaInput } from '../content/types';
import { type Lang, t } from '../i18n/config';
import { resolve, imageFull } from '../lib/media';

type Props = {
  media: MediaInput[];
  lang: Lang;
  /** Sert d'alt quand l'image n'en declare pas. */
  fallbackAlt: string;
};
const { media, lang, fallbackAlt } = Astro.props;

/** 'mur.jpg' et { src: 'mur.jpg', ... } aboutissent au meme objet. */
const normalize = (m: MediaInput): Media => (typeof m === 'string' ? { src: m } : m);

/*
 * Precalcule chaque carte : image optimisee pour la vignette + une version
 * haute-resolution (servie au lightbox au clic). resolve/imageFull sont
 * partages avec Gallery via lib/media.
 */
const cards = await Promise.all(
  media.map(normalize).map(async (m) => {
    const src = resolve(m.src);
    const full = await imageFull(src);
    const alt = m.alt ? t(m.alt, lang) : m.caption ? t(m.caption, lang) : fallbackAlt;
    return { m, src, alt, full };
  }),
);
---

{/*
 * Grille 2 colonnes ALIGNEE (2x2) : toutes les cartes ont la meme taille (ratio
 * 16/10) et l'image REMPLIT la carte (`object-cover`) — aucun trou autour. Les
 * screenshots 16/10 remplissent sans rognage ; un leger crop n'arrive que si le
 * ratio differe. L'image entiere reste accessible au clic (lightbox).
 */}
<div class="grid gap-4 sm:grid-cols-2">
  {
    cards.map(({ m, src, alt, full }) => (
      <figure class="overflow-hidden rounded-card border border-line-soft bg-surface">
        <div class="aspect-[16/10] overflow-hidden bg-bg">
          <Image
            src={src}
            alt={alt}
            data-lightbox
            data-full={full}
            data-alt={alt}
            widths={[480, 960]}
            sizes="(min-width: 640px) 480px, 100vw"
            format="webp"
            quality={80}
            loading="lazy"
            class="size-full cursor-zoom-in object-cover"
          />
        </div>
        {m.caption && (
          <figcaption class="border-t border-line-soft px-4 py-2.5 text-xs leading-relaxed text-ink-faint">
            {t(m.caption, lang)}
          </figcaption>
        )}
      </figure>
    ))
  }
</div>
